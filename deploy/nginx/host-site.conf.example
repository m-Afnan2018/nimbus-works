# Host Nginx (on the VPS) — terminates TLS and forwards to the compose gateway.
#
#   sudo cp deploy/nginx/host-site.conf.example /etc/nginx/conf.d/nimbus-demo.conf
#   # replace nimbus.example.com / nimbus-finance.example.com with your domains
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d nimbus.example.com -d nimbus-finance.example.com
#
# Remember to set WORKSPACE_PUBLIC_URL=https://nimbus.example.com in .env (CORS).
# Names are prefixed nimbus_ so they can't clash with other sites' maps.

map $http_upgrade $nimbus_connection_upgrade {
  default upgrade;
  ''      close;
}

# Behind Cloudflare's proxy, $remote_addr is a Cloudflare edge; the visitor's
# IP is in CF-Connecting-IP. Hand the APIs one clean client IP either way, so
# per-visitor rate limits work (pairs with TRUST_PROXY_HOPS=2).
map $http_cf_connecting_ip $nimbus_client_ip {
  ''      $remote_addr;
  default $http_cf_connecting_ip;
}

server {
  listen 80;
  server_name nimbus.example.com;
  client_max_body_size 1m;

  location /.well-known/acme-challenge/ { root /usr/share/nginx/html; }

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $nimbus_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $nimbus_client_ip;
    proxy_set_header X-Forwarded-For $nimbus_client_ip;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }
}

server {
  listen 80;
  server_name nimbus-finance.example.com;
  client_max_body_size 1m;

  location /.well-known/acme-challenge/ { root /usr/share/nginx/html; }

  location / {
    proxy_pass http://127.0.0.1:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $nimbus_client_ip;
    proxy_set_header X-Forwarded-For $nimbus_client_ip;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
