# ─────────────────────────────────────────────────────────────────────────────
# Nimbus Works demo — docker compose settings. Copy to `.env` and fill in.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas: paste the host part of your connection string, WITHOUT a
# database name or "?options" (compose adds /demo_pm, /demo_private, /demo_cfo):
#   MONGO_HOST=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
#   MONGO_OPTIONS=retryWrites=true&w=majority&maxPoolSize=5
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F).
# The database user needs readWrite on demo_pm, demo_private and demo_cfo, and
# the server's IP must be in Atlas → Network Access.
#
# Local MongoDB container instead of Atlas: keep COMPOSE_PROFILES=local-db and
# leave MONGO_HOST unset (it defaults to mongodb://mongo:27017).
COMPOSE_PROFILES=local-db
MONGO_HOST=
MONGO_OPTIONS=maxPoolSize=5

# Public demo safety switch: blocks deletes, bulk updates, emails, push, uploads
DEMO_MODE=true

# Workspace API auth
JWT_SECRET=change-me-64-hex-chars
JWT_REFRESH_SECRET=change-me-64-hex-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32-byte key, hex encoded (64 chars) — encrypts the credentials vault
CREDENTIALS_ENCRYPTION_KEY=change-me-64-hex-chars

# Finance API auth (single login shown on the finance login page in demo mode)
FINANCE_JWT_SECRET=change-me-64-hex-chars
FINANCE_USERNAME=admin@demo.com
FINANCE_PASSWORD=demo1234

# Public URL of the Workspace app (used for CORS). Must match the browser origin.
WORKSPACE_PUBLIC_URL=http://localhost:8080
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false
# Reverse proxies in front of the APIs: 2 = host Nginx + gateway (the VPS setup),
# 1 = gateway only (local `docker compose up`). Used for per-IP rate limits.
TRUST_PROXY_HOPS=2

# Host ports (bound to 127.0.0.1 only — put Nginx in front)
WORKSPACE_PORT=8080
FINANCE_PORT=8081

# Image tag used by `docker compose` (build here, load on the VPS)
IMAGE_TAG=latest

# Daily reset (hour in UTC) and initial seeding: if-empty | always | never
RESET_HOUR_UTC=3
SEED_ON_START=if-empty

TZ=Asia/Kolkata

# Optional: Web Push (VAPID) keys — push is a no-op in DEMO_MODE anyway
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
